---
const labels =  {
      light: "Switch to light theme",
      dark: "Switch to dark theme",
    };
---

<starlight-theme-toggle>
  <button
    class="theme-toggle"
    type="button"
    aria-label={labels.dark}
    title={labels.dark}
    data-label-light={labels.light}
    data-label-dark={labels.dark}
  >
    <svg
      class="theme-icon theme-icon--sun"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4" />
      <path
        d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42
        M17.65 17.65l1.42 1.42M2 12h2M20 12h2
        M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
      />
    </svg>

    <svg
      class="theme-icon theme-icon--moon"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
    </svg>
  </button>
</starlight-theme-toggle>

<script is:inline>
  (() => {
    const tagName = "starlight-theme-toggle";

    if (customElements.get(tagName)) {
      return;
    }

    class FonijThemeToggle extends HTMLElement {
      connectedCallback() {
        const button = this.querySelector("button");

        if (!button || button.dataset.initialized === "true") {
          return;
        }

        button.dataset.initialized = "true";

        const updateLabel = () => {
          const isDark =
            document.documentElement.dataset.theme === "dark";

          const label = isDark
            ? button.dataset.labelLight
            : button.dataset.labelDark;

          if (label) {
            button.setAttribute("aria-label", label);
            button.setAttribute("title", label);
          }
        };

        button.addEventListener("click", () => {
          const currentTheme =
            document.documentElement.dataset.theme === "dark"
              ? "dark"
              : "light";

          const nextTheme =
            currentTheme === "dark" ? "light" : "dark";

          document.documentElement.dataset.theme = nextTheme;

          localStorage.setItem("starlight-theme", nextTheme);

          if (typeof StarlightThemeProvider !== "undefined") {
            StarlightThemeProvider.updatePickers(nextTheme);
          }

          updateLabel();
        });

        updateLabel();
      }
    }

    customElements.define(tagName, FonijThemeToggle);
  })();
</script>

<style>
  .theme-toggle {
    position: relative;

    display: grid;
    place-items: center;

    width: 2.5rem;
    height: 2.5rem;
    padding: 0;

    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.7rem;

    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);

    cursor: pointer;

    transition:
      background 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .theme-toggle:hover {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text-accent);
  }

  .theme-toggle:focus-visible {
    outline: 3px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  .theme-icon {
    position: absolute;

    width: 1.15rem;
    height: 1.15rem;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;

    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  :global(:root[data-theme="dark"]) .theme-icon--sun {
    opacity: 1;
    transform: scale(1);
  }

  :global(:root[data-theme="dark"]) .theme-icon--moon {
    opacity: 0;
    transform: scale(0.7);
  }

  :global(:root[data-theme="light"]) .theme-icon--sun {
    opacity: 0;
    transform: scale(0.7);
  }

  :global(:root[data-theme="light"]) .theme-icon--moon {
    opacity: 1;
    transform: scale(1);
  }
</style>