---
import StarterCard from "./StarterCard.astro";

import type { Starter } from "../../types/starter";

interface Props {
  starters: Starter[];
  title?: string;
  description?: string;
  columns?: 2 | 3 | 4;
  showSearch?: boolean;
  locale?: "en" | "fa";
}

const {
  starters,
  title,
  description,
  columns = 3,
  showSearch = true,
  locale = "en",
} = Astro.props;

const labels = {
  search:"Search starters...",
  empty: "No starters match your search.",
  technologies: "Technologies",
};
---

<section class="starter-catalog" data-starter-grid>
  {
    (title || description || showSearch) && (
      <div class="starter-catalog__header">
        <div>
          {title && <h2>{title}</h2>}

          {description && <p>{description}</p>}
        </div>

        {
          showSearch && (
            <label class="starter-search">
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7" />
                <path d="m16 16 5 5" />
              </svg>

              <input
                type="search"
                data-starter-search
                placeholder={labels.search}
                aria-label={labels.search}
              />
            </label>
          )
        }
      </div>
    )
  }

  <div
    class="starter-grid"
    style={`--starter-columns: ${columns}`}
  >
    {
      starters.map((starter) => {
        const searchText = [
          starter.name,
          starter.description,
          starter.category,
          ...starter.technologies,
        ]
          .join(" ")
          .toLowerCase();

        return (
          <div
            class="starter-grid__item"
            data-starter-item
            data-search={searchText}
          >
            <StarterCard
              starter={starter}
              locale={locale}
            />
          </div>
        );
      })
    }
  </div>

  <p
    class="starter-catalog__empty"
    data-starter-empty
    hidden
    role="status"
  >
    {labels.empty}
  </p>
</section>

<script>
  const grids = document.querySelectorAll<HTMLElement>(
    "[data-starter-grid]",
  );

  grids.forEach((grid) => {
    const input = grid.querySelector<HTMLInputElement>(
      "[data-starter-search]",
    );

    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>(
        "[data-starter-item]",
      ),
    );

    const emptyState = grid.querySelector<HTMLElement>(
      "[data-starter-empty]",
    );

    input?.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();

      let visibleCount = 0;

      cards.forEach((card) => {
        const searchableText = card.dataset.search ?? "";

        const matches = searchableText.includes(query);

        card.hidden = !matches;

        if (matches) {
          visibleCount++;
        }
      });

      if (emptyState) {
        emptyState.hidden = visibleCount > 0;
      }
    });
  });
</script>

<style>
  .starter-catalog {
    width: 100%;
  }

  .starter-catalog__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;

    margin-block-end: 1.75rem;
  }

  .starter-catalog__header h2 {
    margin: 0 0 0.5rem;

    color: var(--text-strong);

    font-size: 1.4rem;
    font-weight: 750;
  }

  .starter-catalog__header p {
    max-width: 600px;
    margin: 0;

    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .starter-search {
    display: flex;
    align-items: center;
    gap: 0.65rem;

    width: min(100%, 290px);
    height: 2.8rem;
    padding-inline: 0.85rem;

    border: 1px solid var(--border);
    border-radius: 0.7rem;

    background: var(--surface);
    color: var(--muted);

    transition: border-color 160ms ease;
  }

  .starter-search:focus-within {
    border-color: var(--accent);
  }

  .starter-search svg {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .starter-search input {
    width: 100%;
    min-width: 0;

    border: 0;
    outline: none;

    background: transparent;
    color: var(--text);

    font: inherit;
    font-size: 0.82rem;
  }

  .starter-search input::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }

  .starter-grid {
    display: grid;

    grid-template-columns: repeat(
      var(--starter-columns, 3),
      minmax(0, 1fr)
    );

    gap: 1rem;
  }

  .starter-grid__item[hidden] {
    display: none;
  }

  .starter-catalog__empty {
    margin-block: 2rem;
    padding: 2rem;

    border: 1px dashed var(--border);
    border-radius: 0.9rem;

    color: var(--muted);
    text-align: center;
  }

  @media (max-width: 1000px) {
    .starter-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .starter-grid {
      grid-template-columns: 1fr;
    }

    .starter-catalog__header {
      align-items: stretch;
    }

    .starter-search {
      width: 100%;
    }
  }
</style>