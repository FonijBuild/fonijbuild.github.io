---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  level?: "h2" | "h3";
  id?: string;
}

const {
  eyebrow,
  title,
  description,
  align = "left",
  level = "h2",
  id,
} = Astro.props;

const Heading = level;
---

<header
  class:list={[
    "section-heading",
    `section-heading--${align}`,
  ]}
>
  {
    eyebrow && (
      <span class="section-heading__eyebrow">
        {eyebrow}
      </span>
    )
  }

  <Heading class="section-heading__title" id={id}>
    {title}
  </Heading>

  {
    description && (
      <p class="section-heading__description">
        {description}
      </p>
    )
  }
</header>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;

    margin-block-end: 2rem;
  }

  .section-heading--left {
    align-items: flex-start;
    text-align: start;
  }

  .section-heading--center {
    align-items: center;
    text-align: center;
  }

  .section-heading__eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .section-heading__title {
    max-width: 760px;
    margin: 0;

    color: var(--text-strong);

    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1.2;
  }

  .section-heading__description {
    max-width: 650px;
    margin: 0;

    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .section-heading--center .section-heading__description {
    margin-inline: auto;
  }
</style>