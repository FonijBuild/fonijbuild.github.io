
---
type IconName =
  | "web"
  | "mobile"
  | "blog"
  | "ai"
  | "portfolio"
  | "terminal"
  | "package"
  | "docs"
  | "llm"
  | "api"
  | "extension"
  | "monorepo";

type Tone = "violet" | "blue" | "green" | "indigo";

interface Props {
  title: string;
  description: string;
  href: string;
  icon: IconName;
  tone?: Tone;
  index: string;
}

const {
  title,
  description,
  href,
  icon,
  tone = "violet",
  index,
} = Astro.props;
---

<a class={`product-card product-card--${tone}`} href={href}>
  <div class="product-card__top">
    <span class="product-card__icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        {icon === "web" && (
          <g>
            <rect x="3" y="4" width="18" height="13" rx="2" />
            <path d="M8 21h8M12 17v4" />
            <path d="M3 8h18" />
          </g>
        )}

        {icon === "mobile" && (
          <g>
            <rect x="7" y="2" width="10" height="20" rx="2.5" />
            <path d="M11 18h2" />
          </g>
        )}

        {icon === "blog" && (
          <g>
            <path d="M6 3.5h8l4 4V20H6a3 3 0 0 1-3-3V6.5a3 3 0 0 1 3-3Z" />
            <path d="M14 3.5v5h4M8 12h7M8 16h7" />
          </g>
        )}

        {icon === "ai" && (
          <g>
            <path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z" />
            <path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z" />
            <path d="m5 15 .6 1.4L7 17l-1.4.6L5 19l-.6-1.4L3 17l1.4-.6L5 15Z" />
          </g>
        )}

        {icon === "portfolio" && (
          <g>
            <rect x="3" y="7" width="18" height="14" rx="2" />
            <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18M10 12v2h4v-2" />
          </g>
        )}

        {icon === "terminal" && (
          <g>
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <path d="m7 9 3 3-3 3M13 15h4" />
          </g>
        )}

        {icon === "package" && (
          <g>
            <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" />
            <path d="m4.5 7.8 7.5 4.3 7.5-4.3M12 12v9" />
          </g>
        )}

        {icon === "docs" && (
          <g>
            <path d="M12 6.5C9.5 4.5 6.5 4 3 5v14c3.5-1 6.5-.5 9 1.5" />
            <path d="M12 6.5C14.5 4.5 17.5 4 21 5v14c-3.5-1-6.5-.5-9 1.5M12 6.5v14" />
          </g>
        )}

        {icon === "llm" && (
          <g>
            <circle cx="12" cy="5" r="2" />
            <circle cx="5" cy="18" r="2" />
            <circle cx="19" cy="18" r="2" />
            <circle cx="12" cy="13" r="2" />
            <path d="m11 7-4.5 9M13 7l4.5 9M7 18h10" />
          </g>
        )}

        {icon === "api" && (
          <g>
            <path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" />
          </g>
        )}

        {icon === "extension" && (
          <g>
            <path d="M4 4h6v3a2 2 0 1 0 4 0V4h6v6h-3a2 2 0 1 0 0 4h3v6h-6v-3a2 2 0 1 0-4 0v3H4v-6h3a2 2 0 1 0 0-4H4V4Z" />
          </g>
        )}

        {icon === "monorepo" && (
          <g>
            <rect x="3" y="4" width="8" height="7" rx="1.5" />
            <rect x="13" y="4" width="8" height="7" rx="1.5" />
            <rect x="8" y="14" width="8" height="7" rx="1.5" />
            <path d="M7 11v1.5h10V11" />
          </g>
        )}
      </svg>
    </span>

    <span class="product-card__index">{index}</span>
  </div>

  <div class="product-card__content">
    <h3 class="product-card__title">{title}</h3>
    <p class="product-card__description">{description}</p>
  </div>

  <div class="product-card__footer">
    <span>Explore guide</span>

    <span class="product-card__arrow" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M7 17 17 7M7 7h10v10" />
      </svg>
    </span>
  </div>
</a>
