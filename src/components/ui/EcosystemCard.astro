---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: "book" | "layers" | "terminal";
  tone?: "violet" | "blue" | "green";
  eyebrow?: string;
  cta?: string;
}

const {
  title,
  description,
  href,
  icon,
  tone = "violet",
  eyebrow,
  cta = "Explore",
} = Astro.props;
---

<a
  class:list={[
    "ecosystem-card",
    `ecosystem-card--${tone}`,
  ]}
  href={href}
>
  <div class="ecosystem-card__top">
    <div class="ecosystem-card__icon" aria-hidden="true">
      {
        icon === "book" && (
          <svg viewBox="0 0 24 24">
            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 0 4 22z" />
            <path d="M4 5.5v14A2.5 2.5 0 0 1 6.5 17H20" />
            <path d="M8 7h8M8 10h6" />
          </svg>
        )
      }

      {
        icon === "layers" && (
          <svg viewBox="0 0 24 24">
            <path d="m12 3 9 5-9 5-9-5z" />
            <path d="m3 12 9 5 9-5" />
            <path d="m3 16 9 5 9-5" />
          </svg>
        )
      }

      {
        icon === "terminal" && (
          <svg viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="16" rx="3" />
            <path d="m7 9 3 3-3 3M13 15h4" />
          </svg>
        )
      }
    </div>

    <svg
      class="ecosystem-card__arrow"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M7 17 17 7M7 7h10v10" />
    </svg>
  </div>

  <div class="ecosystem-card__content">
    {eyebrow && <span class="ecosystem-card__eyebrow">{eyebrow}</span>}

    <h3>{title}</h3>

    <p>{description}</p>
  </div>

  <div class="ecosystem-card__footer">
    <span>{cta}</span>

    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </div>
</a>

<style>
  .ecosystem-card {
    --card-accent: #8b75ff;
    --card-soft: rgb(139 117 255 / 9%);

    position: relative;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    min-height: 265px;
    padding: 1.6rem;

    overflow: hidden;

    border: 1px solid color-mix(
      in srgb,
      var(--card-accent) 30%,
      var(--border)
    );

    border-radius: 1.1rem;

    background:
      radial-gradient(
        circle at 90% 5%,
        var(--card-soft),
        transparent 65%
      ),
      var(--surface);

    color: var(--text);
    text-decoration: none;

    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .ecosystem-card--violet {
    --card-accent: #8b75ff;
    --card-soft: rgb(139 117 255 / 11%);
  }

  .ecosystem-card--blue {
    --card-accent: #3185ff;
    --card-soft: rgb(49 133 255 / 10%);
  }

  .ecosystem-card--green {
    --card-accent: #20b981;
    --card-soft: rgb(32 185 129 / 10%);
  }

  .ecosystem-card:hover {
    transform: translateY(-5px);

    border-color: var(--card-accent);

    box-shadow: 0 16px 35px rgb(0 0 0 / 8%);

    color: var(--text);
    text-decoration: none;
  }

  .ecosystem-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ecosystem-card__icon {
    display: grid;
    place-items: center;

    width: 3.25rem;
    height: 3.25rem;

    border: 1px solid color-mix(
      in srgb,
      var(--card-accent) 35%,
      transparent
    );

    border-radius: 0.9rem;

    background: var(--card-soft);
    color: var(--card-accent);
  }

  .ecosystem-card__icon svg {
    width: 1.55rem;
    height: 1.55rem;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ecosystem-card__arrow {
    width: 1.2rem;
    height: 1.2rem;

    fill: none;
    stroke: var(--muted);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;

    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .ecosystem-card:hover .ecosystem-card__arrow {
    color: var(--card-accent);
    transform: translate(3px, -3px);
  }

  .ecosystem-card__content {
    margin-block: 2rem;
  }

  .ecosystem-card__eyebrow {
    display: block;

    margin-block-end: 0.6rem;

    color: var(--card-accent);

    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ecosystem-card h3 {
    margin: 0 0 0.7rem;

    color: var(--text-strong);

    font-size: 1.4rem;
    font-weight: 750;
    letter-spacing: -0.035em;
  }

  .ecosystem-card p {
    max-width: 360px;
    margin: 0;

    color: var(--muted);

    font-size: 0.9rem;
    line-height: 1.75;
  }

  .ecosystem-card__footer {
    display: flex;
    align-items: center;
    gap: 0.6rem;

    color: var(--card-accent);

    font-size: 0.85rem;
    font-weight: 700;
  }

  .ecosystem-card__footer svg {
    width: 1rem;
    height: 1rem;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;

    transition: transform 180ms ease;
  }

  .ecosystem-card:hover .ecosystem-card__footer svg {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .ecosystem-card,
    .ecosystem-card * {
      transition: none;
    }

    .ecosystem-card:hover {
      transform: none;
    }
  }
</style>